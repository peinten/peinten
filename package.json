{
  "name": "peinten-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "check:unused": "node scripts/check-unused.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "ts-morph": "28.0.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "webgpu"
    ],
    "overrides": {
      "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2"
    },
    "packageExtensions": {
      "@ts-morph/common": {
        "dependencies": {
          "typescript": "*"
        }
      }
    },
    "patchedDependencies": {
      "@ts-morph/common@0.29.0": "patches/@ts-morph__common@0.29.0.patch"
    }
  }
}
